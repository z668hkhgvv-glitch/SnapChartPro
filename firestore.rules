rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function memberRef(teamId) {
      return /databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid);
    }

    function isMember(teamId) {
      return signedIn() && exists(memberRef(teamId));
    }

    function memberRole(teamId) {
      return get(memberRef(teamId)).data.role;
    }

    function isEditor(teamId) {
      return isMember(teamId) && memberRole(teamId) in ["admin", "editor"];
    }

    function isAdmin(teamId) {
      return isMember(teamId) && memberRole(teamId) == "admin";
    }

    function isTeamOwner(teamId) {
      return signedIn() &&
        get(/databases/$(database)/documents/teams/$(teamId)).data.ownerUid == request.auth.uid;
    }

    // Invite document key is simply the lowercased email address.
    // Firestore document IDs support @ and . — no encoding needed.
    function inviteKeyFor(email) {
      return email.lower();
    }

    // Require email_verified to prevent invite hijacking via pre-registration
    // with an unverified account on someone else's email address.
    function pendingInviteForTeam(teamId) {
      return request.auth.token.email != null &&
        request.auth.token.email_verified == true &&
        exists(/databases/$(database)/documents/invites/$(inviteKeyFor(request.auth.token.email))) &&
        get(/databases/$(database)/documents/invites/$(inviteKeyFor(request.auth.token.email))).data.teamId == teamId;
    }

    function inviteDocFor() {
      return get(/databases/$(database)/documents/invites/$(inviteKeyFor(request.auth.token.email)));
    }

    function gameEnded(teamId, gameId) {
      return get(/databases/$(database)/documents/teams/$(teamId)/games/$(gameId)).data.get('ended', false) == true;
    }

    // ── userTeams/{uid} — personal team-lookup doc, owner only ───────────────

    match /userTeams/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ── teams/{teamId} — team root document ──────────────────────────────────

    match /teams/{teamId} {
      allow read:   if isMember(teamId);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin(teamId);
      allow delete: if false;
    }

    // ── teams/{teamId}/members/{memberId} ────────────────────────────────────

    match /teams/{teamId}/members/{memberId} {
      allow read: if isMember(teamId);

      allow create: if signedIn() && (
        // Team owner adding themselves as first admin during createTeamWithAdmin
        (request.auth.uid == memberId && isTeamOwner(teamId)) ||
        // Existing admin inviting a coach (creates the member doc on accept)
        isAdmin(teamId) ||
        // Invite acceptance: user creating their own (non-admin) member doc
        // — verified against a pending invite on this team (email must be verified)
        // — role must match the invite exactly (no readonly→editor escalation)
        // — stored email must match the authenticated token email
        (request.auth.uid == memberId &&
         request.resource.data.role in ["editor", "readonly"] &&
         pendingInviteForTeam(teamId) &&
         request.resource.data.role == inviteDocFor().data.role &&
         request.resource.data.email == request.auth.token.email.lower())
      );

      allow update: if isAdmin(teamId);
      allow delete: if isAdmin(teamId);
    }

    // ── teams/{teamId}/games/{gameId} ────────────────────────────────────────
    // Editors can create/update games but cannot change the `ended` field —
    // only admins can lock or reopen a game.

    match /teams/{teamId}/games/{gameId} {
      allow read:   if isMember(teamId);
      allow create: if isEditor(teamId);
      allow update: if isEditor(teamId) && (
        isAdmin(teamId) ||
        !("ended" in request.resource.data.diff(resource.data).affectedKeys())
      );
      allow delete: if isAdmin(teamId);
    }

    // ── teams/{teamId}/games/{gameId}/plays/{playId} ─────────────────────────
    // Admins bypass the ended lock; editors are blocked when the game is ended.

    match /teams/{teamId}/games/{gameId}/plays/{playId} {
      allow read: if isMember(teamId);

      allow create, update: if isEditor(teamId) &&
        (isAdmin(teamId) || !gameEnded(teamId, gameId));

      allow delete: if isEditor(teamId) &&
        (isAdmin(teamId) || !gameEnded(teamId, gameId));
    }

    // ── teams/{teamId}/seasons/{seasonId} ────────────────────────────────────

    match /teams/{teamId}/seasons/{seasonId} {
      allow read:   if isMember(teamId);
      allow create: if isEditor(teamId);
      allow update: if false;
      allow delete: if isAdmin(teamId);
    }

    // NOTE: No catch-all write rule — all write paths must be explicitly listed
    // above. Omitting a catch-all means any unlisted subcollection defaults to
    // deny, which is the secure default.

    // ── invites/{emailKey} ───────────────────────────────────────────────────

    match /invites/{emailKey} {
      allow read: if signedIn() && (
        request.auth.token.email != null &&
          request.auth.token.email.lower() == resource.data.email ||
        isAdmin(resource.data.teamId)
      );

      allow create: if signedIn() && isAdmin(request.resource.data.teamId) &&
        request.resource.data.role in ["editor", "readonly"] &&
        emailKey == request.resource.data.email.lower();

      allow delete: if signedIn() && (
        request.auth.token.email != null &&
          request.auth.token.email.lower() == resource.data.email ||
        isAdmin(resource.data.teamId)
      );

      allow update: if false;
    }

    // ── licenses/{key} ───────────────────────────────────────────────────────

    match /licenses/{key} {
      // A user can only read the license for a team they are actually a member of.
      // This prevents reading other teams' license data by self-writing userTeams.
      allow read: if signedIn() && (
        request.auth.token.email == 'rcatalano1@gmail.com' ||
        (resource.data.activatedTeam is string &&
         isMember(resource.data.activatedTeam))
      );

      allow create, delete: if signedIn() &&
        request.auth.token.email == 'rcatalano1@gmail.com';

      allow update: if signedIn() && (
        // Admin can change anything
        request.auth.token.email == 'rcatalano1@gmail.com' ||
        // User activating an unactivated key — must be an admin of the target team.
        // Using isAdmin(activatedTeam) instead of userTeamId() prevents a user from
        // self-writing their userTeams doc to point at a victim team and stealing an
        // activation slot.
        (resource.data.activatedTeam == null &&
         request.resource.data.activatedBy   == request.auth.uid &&
         request.resource.data.activatedTeam is string &&
         isAdmin(request.resource.data.activatedTeam) &&
         // Must activate to "active" status (not any other value)
         request.resource.data.status        == "active" &&
         // expiresAt must be a timestamp between 29 and 366 days from now
         request.resource.data.expiresAt     is timestamp &&
         request.resource.data.expiresAt     >= request.time + duration.value(29, 'd') &&
         request.resource.data.expiresAt     <= request.time + duration.value(366, 'd') &&
         // Lock these fields against modification
         request.resource.data.tier          == resource.data.tier &&
         request.resource.data.maxCoaches    == resource.data.maxCoaches &&
         request.resource.data.issuedTo      == resource.data.issuedTo)
      );
    }

  }
}
